# Bzlmod lockfile.
MODULE.bazel.lock
# Bazel symlinks, e.g. bazel-out.
bazel-*
user.bazelrc
# clangd compilation database, index cache, and the
# symlink to external repositories under output base.
/compile_commands.json
/.cache/
/external

# Generated Python artifacts.
*.pyc
# Built wheels, consumed by the nox smoke-test sessions.
dist/
*/**/__pycache__
# Virtual environments
.venv/
# Vim swap files (used for recovery).
.*.swp
.*.swo
.*.swn
# Vim backups.
*~
.*~
# Vim undo files.
*.un~
.*.un~

# Relay presubmit run output.
presubmit_reports/
# Agent scratch state.
.agents/
# Scratch notes and exploratory test scaffolding from bringing the relay up.
/ORIGINAL_REQUEST.md
/PROJECT.md
/TEST_INFRA.md
/TEST_READY.md
